{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cyber-MKO/xvm/scenarios/scenario.schema.json",
  "title": "xvm scenario",
  "type": "object",
  "required": ["schema", "kind", "name", "os", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "kind": {"const": "scenario"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "description": {"type": "string"},
    "os": {"enum": ["windows", "linux", "macos"]},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": {"type": "string", "description": "Account the steps act as, by name."}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["at", "action"],
        "additionalProperties": false,
        "properties": {
          "at": {
            "description": "Offset from the scenario start: 5s, 500ms, 2m, 1h, or seconds.",
            "oneOf": [
              {"type": "number", "minimum": 0},
              {"type": "string", "pattern": "^\\s*\\d+(\\.\\d+)?\\s*(ms|s|m|h)?\\s*$"}
            ]
          },
          "name": {"type": "string"},
          "action": {"type": "string"},
          "params": {"type": "object"}
        }
      }
    }
  }
}
