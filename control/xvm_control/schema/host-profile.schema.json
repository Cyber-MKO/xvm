{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cyber-MKO/xvm/control/host-profile.schema.json",
  "title": "xvm host profile or base image",
  "description": "A base image holds the facts shared by many hosts. A host profile names a base and lists only what differs. Every host fact an emulated host reports comes from these files (CLAUDE.md rule 5).",
  "type": "object",
  "required": [
    "schema",
    "kind",
    "name",
    "os"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "enum": [
        "base-image",
        "host-profile",
        "resolved-host"
      ]
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "description": {
      "type": "string"
    },
    "base": {
      "$ref": "#/$defs/name"
    },
    "source": {
      "description": "Where the facts came from, for example a golden capture manifest.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "golden_capture": {
          "type": "string"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "os": {
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,62}$"
        },
        "domain": {
          "type": "string"
        },
        "machine_id": {
          "type": "string"
        }
      }
    },
    "os_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_name": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "ubr": {
          "type": "integer",
          "minimum": 0
        },
        "display_version": {
          "type": "string"
        },
        "architecture": {
          "enum": [
            "x86",
            "x86_64",
            "arm64"
          ]
        },
        "install_date": {
          "type": "string",
          "format": "date-time"
        },
        "locale": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "last_boot": {
          "type": "string",
          "format": "date-time",
          "description": "Boot time. Without it the engine uses its own start time."
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "vendor": {
              "type": "string"
            },
            "cores": {
              "type": "integer",
              "minimum": 1
            },
            "logical_processors": {
              "type": "integer",
              "minimum": 1
            },
            "mhz": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "system": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manufacturer": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "uuid": {
              "type": "string"
            },
            "serial": {
              "type": "string"
            }
          }
        },
        "bios": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vendor": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "release_date": {
              "type": "string"
            },
            "serial": {
              "type": "string"
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          }
        },
        "dns_suffix": {
          "type": "string"
        }
      }
    },
    "users": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/user"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "software": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "hotfixes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hotfix"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "registry": {
      "description": "Windows only. Keys use hive abbreviations (HKLM, HKU, HKCR).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(HKLM|HKU|HKCR)(\\\\[^\\\\]+)+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "$ref": "#/$defs/regvalue"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "delete_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(HKLM|HKU|HKCR)(\\\\[^\\\\]+)+$"
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version"
      ],
      "properties": {
        "product": {
          "enum": [
            "wazuh"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "manager": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "description": "The agent's process ID. On Windows a non-zero multiple of 4. The personality registers the agent with the engine under it."
        },
        "command_line": {
          "type": "string",
          "minLength": 1,
          "description": "The agent process's full command line. Its program name picks the executable."
        },
        "current_directory": {
          "type": "string",
          "minLength": 1,
          "description": "The agent's starting directory."
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "description": "Windows: the service the Service Control Manager starts the agent as."
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "The agent's environment variables."
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "description": "Windows settings that are neither registry values nor files.",
      "properties": {
        "system_module_directory": {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\",
          "description": "Where emulated system DLLs report they were loaded from, such as C:\\Windows\\SysWOW64 for a 32-bit process on 64-bit Windows."
        },
        "cert_stores": {
          "type": "object",
          "description": "System certificate store (ROOT, CA, MY) to its certificates.",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "der"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "der": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                  "description": "The certificate, DER in base64."
                }
              }
            }
          }
        },
        "trusted_files": {
          "type": "object",
          "description": "Windows path to the SHA-256 of a file whose signature is valid on this host.",
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "files": {
      "description": "Files and directories. Keyed by path: case-insensitive on Windows and macOS.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "processes": {
      "description": "Processes running at boot. Keyed by id, a label local to the profile.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/process"
      }
    },
    "event_messages": {
      "description": "Event message templates, as EvtFormatMessage returns them: provider name to event key (\"4624\" or \"4624/2\" for a version) to text. %1, %2... insert the event's data values in order; %% is a percent sign. Built from a golden capture's rendered events.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[0-9]{1,5}(/[0-9]{1,3})?$"
        },
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "host-profile"
          }
        }
      },
      "then": {
        "required": [
          "base",
          "identity"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "base-image"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "base"
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "os": {
              "const": "windows"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "registry"
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "os": {
              "const": "windows"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "event_messages"
          ]
        }
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "remove": {
      "description": "In a host profile, deletes the base entry with the same key.",
      "const": true
    },
    "interface": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "remove": {
          "$ref": "#/$defs/remove"
        },
        "description": {
          "type": "string"
        },
        "mac": {
          "type": "string",
          "pattern": "^([0-9A-F]{2}:){5}[0-9A-F]{2}$"
        },
        "ipv4": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}/\\d{1,2}$"
          }
        },
        "gateway": {
          "type": "string"
        },
        "dns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dhcp": {
          "type": "boolean"
        },
        "guid": {
          "type": "string",
          "pattern": "^\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}$"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "integer",
          "minimum": 1
        },
        "mtu": {
          "type": "integer",
          "minimum": 0
        },
        "speed": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "up",
            "down",
            "testing",
            "unknown",
            "dormant",
            "not_present",
            "lower_layer_down"
          ]
        },
        "metric": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "user": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "remove": {
          "$ref": "#/$defs/remove"
        },
        "sid": {
          "type": "string",
          "pattern": "^S-1-(\\d+-)*\\d+$"
        },
        "uid": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "home": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "remove": {
          "$ref": "#/$defs/remove"
        },
        "sid": {
          "type": "string",
          "pattern": "^S-1-(\\d+-)*\\d+$"
        },
        "gid": {
          "type": "integer"
        }
      }
    },
    "package": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "remove": {
          "$ref": "#/$defs/remove"
        },
        "version": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "architecture": {
          "enum": [
            "x86",
            "x86_64",
            "arm64",
            "noarch"
          ]
        },
        "install_date": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "uninstall_key": {
          "type": "string",
          "pattern": "^[^\\\\]{1,255}$",
          "description": "Windows: the name of the package's Uninstall registry key, such as an MSI product code. Defaults to name."
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "remove": {
          "$ref": "#/$defs/remove"
        },
        "display_name": {
          "type": "string"
        },
        "state": {
          "enum": [
            "running",
            "stopped"
          ]
        },
        "start_mode": {
          "enum": [
            "auto",
            "manual",
            "disabled",
            "boot",
            "system"
          ]
        },
        "path": {
          "type": "string"
        },
        "account": {
          "type": "string"
        }
      }
    },
    "regvalue": {
      "type": "object",
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "REG_SZ",
            "REG_EXPAND_SZ",
            "REG_MULTI_SZ",
            "REG_DWORD",
            "REG_QWORD",
            "REG_BINARY"
          ]
        },
        "data": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "REG_SZ",
                  "REG_EXPAND_SZ"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "REG_MULTI_SZ"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "REG_DWORD"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "REG_QWORD"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "REG_BINARY"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})*$"
              }
            }
          }
        }
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "file": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "remove": {
          "$ref": "#/$defs/remove",
          "description": "Deletes the base entry and, for a directory, everything below it."
        },
        "type": {
          "enum": [
            "file",
            "dir"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "created": {
          "$ref": "#/$defs/time"
        },
        "modified": {
          "$ref": "#/$defs/time"
        },
        "accessed": {
          "$ref": "#/$defs/time"
        },
        "attributes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "readonly",
              "hidden",
              "system",
              "archive",
              "compressed",
              "encrypted",
              "temporary",
              "offline",
              "not_content_indexed",
              "sparse",
              "reparse_point"
            ]
          }
        },
        "owner": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{3,4}$"
        },
        "content": {
          "description": "Bytes we author. Vendor files carry metadata only (CLAUDE.md rule 1).",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "base64"
              ],
              "additionalProperties": false,
              "properties": {
                "base64": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "blob"
              ],
              "additionalProperties": false,
              "properties": {
                "blob": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "dir"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "size"
                  ]
                },
                {
                  "required": [
                    "sha256"
                  ]
                },
                {
                  "required": [
                    "content"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "process": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "remove": {
          "$ref": "#/$defs/remove"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "command_line": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "pid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "session": {
          "type": "integer",
          "minimum": 0
        },
        "start_offset_s": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds after boot."
        }
      }
    },
    "hotfix": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "remove": {
          "$ref": "#/$defs/remove"
        },
        "description": {
          "type": "string"
        },
        "installed_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "installed_by": {
          "type": "string"
        }
      }
    }
  }
}
